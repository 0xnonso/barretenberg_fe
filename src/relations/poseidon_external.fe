// Port of Aztec Labs (2024) pinned Relations.sol: accumulatePoseidonExternalRelation.
use ingot::entities::{
    Q_4,
    Q_L,
    Q_O,
    Q_POSEIDON2_EXTERNAL,
    Q_R,
    W_4,
    W_4_SHIFT,
    W_L,
    W_L_SHIFT,
    W_O,
    W_O_SHIFT,
    W_R,
    W_R_SHIFT,
}
use ingot::field::Fr

#[inline(never)]
pub fn accumulate(_ p: [Fr; 41], _ evals: mut [Fr; 31], _ domain_sep: Fr) {
    let s1 = p[W_L] + p[Q_L]
    let s2 = p[W_R] + p[Q_R]
    let s3 = p[W_O] + p[Q_O]
    let s4 = p[W_4] + p[Q_4]
    let u1 = s1 * s1 * s1 * s1 * s1
    let u2 = s2 * s2 * s2 * s2 * s2
    let u3 = s3 * s3 * s3 * s3 * s3
    let u4 = s4 * s4 * s4 * s4 * s4
    let t0 = u1 + u2
    let t1 = u3 + u4
    let t2 = u2 + u2 + t1
    let t3 = u4 + u4 + t0
    var v4 = t1 + t1
    v4 = v4 + v4 + t3
    var v2 = t0 + t0
    v2 = v2 + v2 + t2
    let v1 = t3 + v2
    let v3 = t2 + v4
    let q_pos_by_scaling = p[Q_POSEIDON2_EXTERNAL] * domain_sep
    evals[23] = evals[23] + q_pos_by_scaling * (v1 - p[W_L_SHIFT])
    evals[24] = evals[24] + q_pos_by_scaling * (v2 - p[W_R_SHIFT])
    evals[25] = evals[25] + q_pos_by_scaling * (v3 - p[W_O_SHIFT])
    evals[26] = evals[26] + q_pos_by_scaling * (v4 - p[W_4_SHIFT])
}
