use core::result::Result
use ingot::encoding::{ProofReadError, ProofReader}
use ingot::field::{FQ_MODULUS, FR_MODULUS}
use std::abi::{Bytes, bytes_from_word, bytes_from_words}

#[test]
fn reads_big_endian_words_and_preserves_high_bits() {
    let first: u256 = 0x0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20
    let max: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    var reader = ProofReader::new(bytes_from_words([first, max]))
    assert!(reader.position() == 0 && reader.remaining() == 64)
    assert!(word(reader.read_word()) == first)
    assert!(reader.position() == 32 && reader.remaining() == 32)
    assert!(word(reader.read_word()) == max)
    assert!(reader.finish().is_ok())
    assert!(reader.read_word().is_err())
    assert!(reader.position() == 64)
}

#[test]
fn short_reads_fail_without_consuming_or_zero_padding() {
    var len: usize = 0
    while len < 64 {
        var reader = ProofReader::new(Bytes::zeroed(len))
        assert!(reader.read_g1().is_err())
        assert!(reader.position() == 0)
        if len < 32 {
            assert!(reader.read_word().is_err())
            assert!(reader.read_fr().is_err())
            assert!(reader.read_fq().is_err())
            assert!(reader.position() == 0)
        }
        len += 1
    }
}

#[test]
fn scalar_and_coordinate_ranges_are_distinct() {
    var reader = ProofReader::new(bytes_from_words([FR_MODULUS - 1, FR_MODULUS, FQ_MODULUS]))
    match reader.read_fr() {
        Result::Ok(value) => assert!(value.to_word() == FR_MODULUS - 1),
        Result::Err(_) => core::panic(),
    }
    match reader.read_fr() {
        Result::Err(ProofReadError::NonCanonicalScalar) => {},
        _ => core::panic(),
    }
    assert!(reader.position() == 32)
    match reader.read_fq() {
        Result::Ok(value) => assert!(value.to_word() == FR_MODULUS),
        Result::Err(_) => core::panic(),
    }
    match reader.read_fq() {
        Result::Err(ProofReadError::NonCanonicalCoordinate) => {},
        _ => core::panic(),
    }
    assert!(reader.position() == 64)
    assert!(word(reader.read_word()) == FQ_MODULUS)
}

#[test]
fn point_failure_is_atomic_even_for_invalid_second_coordinate() {
    var reader = ProofReader::new(bytes_from_words([1, FQ_MODULUS]))
    match reader.read_g1() {
        Result::Err(ProofReadError::NonCanonicalCoordinate) => {},
        _ => core::panic(),
    }
    assert!(reader.position() == 0 && reader.remaining() == 64)
    assert!(word(reader.read_word()) == 1)
    assert!(word(reader.read_word()) == FQ_MODULUS)
}

#[test]
fn encoded_points_do_not_claim_curve_membership() {
    var reader = ProofReader::new(bytes_from_words([0, 0, 1, 1]))
    match reader.read_g1() {
        Result::Ok(point) => assert!(point.x.to_word() == 0 && point.y.to_word() == 0),
        Result::Err(_) => core::panic(),
    }
    // (1,1) is off-curve but its coordinates are canonical.
    match reader.read_g1() {
        Result::Ok(point) => assert!(point.x.to_word() == 1 && point.y.to_word() == 1),
        Result::Err(_) => core::panic(),
    }
    assert!(reader.finish().is_ok())
}

#[test]
fn skip_uses_remaining_length_and_rejects_overflow() {
    var reader = ProofReader::new(bytes_from_word(7))
    assert!(reader.skip(1).is_ok())
    assert!(
        reader.skip(
                0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff,
            ).is_err(),
    )
    assert!(reader.position() == 1)
    assert!(reader.skip(32).is_err())
    assert!(reader.skip(31).is_ok())
    assert!(reader.skip(0).is_ok())
    assert!(reader.skip(1).is_err())
    assert!(reader.position() == 32 && reader.finish().is_ok())
}

#[test]
fn unaligned_read_stays_big_endian_and_finish_rejects_trailing_bytes() {
    var reader = ProofReader::new(bytes_from_words([1, 0]))
    assert!(reader.skip(1).is_ok())
    assert!(word(reader.read_word()) == 256)
    match reader.finish() {
        Result::Err(ProofReadError::TrailingBytes) => {},
        _ => core::panic(),
    }
    assert!(reader.position() == 33 && reader.remaining() == 31)
    assert!(reader.read_word().is_err())
    assert!(reader.skip(31).is_ok())
    assert!(reader.finish().is_ok())
    let empty = ProofReader::new(Bytes::empty())
    assert!(empty.finish().is_ok())
}

fn word(_ result: Result<ProofReadError, u256>) -> u256 {
    match result {
        Result::Ok(value) => value,
        Result::Err(_) => core::panic(),
    }
}
